@article{mate_ontology-based_2015,
	title = {Ontology-{Based} {Data} {Integration} between {Clinical} and {Research} {Systems}},
	volume = {10},
	issn = {1932-6203},
	url = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC4294641/},
	doi = {10.1371/journal.pone.0116656},
	abstract = {Data from the electronic medical record comprise numerous structured but uncoded ele-ments, which are not linked to standard terminologies. Reuse of such data for secondary research purposes has gained in importance recently. However, the identification of rele-vant data elements and the creation of database jobs for extraction, transformation and loading (ETL) are challenging: With current methods such as data warehousing, it is not feasible to efficiently maintain and reuse semantically complex data extraction and trans-formation routines. We present an ontology-supported approach to overcome this challenge by making use of abstraction: Instead of defining ETL procedures at the database level, we use ontologies to organize and describe the medical concepts of both the source system and the target system. Instead of using unique, specifically developed SQL statements or ETL jobs, we define declarative transformation rules within ontologies and illustrate how these constructs can then be used to automatically generate SQL code to perform the desired ETL procedures. This demonstrates how a suitable level of abstraction may not only aid the interpretation of clinical data, but can also foster the reutilization of methods for un-locking it.},
	number = {1},
	urldate = {2015-02-26},
	journal = {PLoS ONE},
	author = {Mate, Sebastian and Köpcke, Felix and Toddenroth, Dennis and Martin, Marcus and Prokosch, Hans-Ulrich and Bürkle, Thomas and Ganslandt, Thomas},
	year = {2015},
	pmid = {25588043},
	pmcid = {PMC4294641},
	file = {Mate et al. - 2015 - Ontology-Based Data Integration between Clinical a.pdf:/Users/samueldussault/Zotero/storage/2SZUJEUD/Mate et al. - 2015 - Ontology-Based Data Integration between Clinical a.pdf:application/pdf},
}

@inproceedings{chen_dartgrid_2005,
	title = {{DartGrid} {III}: {A} {Semantic} {Grid} {Toolkit} for {Data} {Integration}},
	shorttitle = {{DartGrid} {III}},
	doi = {10.1109/SKG.2005.60},
	abstract = {A toolkit called DartGrid using technologies from either semantic Web or grid is introduced. It is build upon Globus Toolkit and uses RDF-based ontology to integrate heterogeneous relational databases. Technically, database resources are exposed as grid services and organized as an ontology-based virtual organization. By uniformly defined domain semantics, data resources are semantically registered to an semantic registration service and seamlessly integrated together to provide unified semantic query and semantic search service. Furthermore, a set of semantic tools are developed to raise the level of interaction with the system to a semantic level. A visual mapping tool is offered to help data provider to define semantic mapping from relational schema to shared ontology. A visual query tool which can automatically generated query interface based on ontology definitions, is provided to help specify complex semantic queries. A search-engine-like interface is offered to enable quickly search and semantically navigate data from one database to another database. DartGrid is a deployed system that currently provides query and search service at China Academy of Traditional Chinese Medicine .},
	booktitle = {2005 {First} {International} {Conference} on {Semantics}, {Knowledge} and {Grid}},
	author = {Chen, Huajun and Wu, Zhaohui},
	year = {2005},
	keywords = {Relational databases, Ontologies, Semantic Web, Resource description framework, Computer science, Resource management, Computer architecture, Educational institutions, Navigation, Visual databases},
	pages = {12--12},
	file = {Chen et Wu - 2005 - DartGrid III A Semantic Grid Toolkit for Data Int.pdf:/Users/samueldussault/Zotero/storage/5V6VQ9HY/Chen et Wu - 2005 - DartGrid III A Semantic Grid Toolkit for Data Int.pdf:application/pdf;IEEE Xplore Abstract Record:/Users/samueldussault/Zotero/storage/DUSWZ8E2/4125800.html:text/html},
}

@article{asprino_knowledge_2023,
	title = {Knowledge {Graph} {Construction} with a {Façade}: {A} {Unified} {Method} to {Access} {Heterogeneous} {Data} {Sources} on the {Web}},
	volume = {23},
	issn = {1533-5399},
	shorttitle = {Knowledge {Graph} {Construction} with a {Façade}},
	url = {https://dl.acm.org/doi/10.1145/3555312},
	doi = {10.1145/3555312},
	abstract = {Data integration is the dominant use case for RDF Knowledge Graphs. However, Web resources come in formats with weak semantics (for example, CSV and JSON), or formats specific to a given application (for example, BibTex, HTML, and Markdown). To solve this problem, Knowledge Graph Construction (KGC) is gaining momentum due to its focus on supporting users in transforming data into RDF. However, using existing KGC frameworks result in complex data processing pipelines, which mix structural and semantic mappings, whose development and maintenance constitute a significant bottleneck for KG engineers. Such frameworks force users to rely on different tools, sometimes based on heterogeneous languages, for inspecting sources, designing mappings, and generating triples, thus making the process unnecessarily complicated. We argue that it is possible and desirable to equip KG engineers with the ability of interacting with Web data formats by relying on their expertise in RDF and the well-established SPARQL query language [2]. In this article, we study a unified method for data access to heterogeneous data sources with Facade-X, a meta-model implemented in a new data integration system called SPARQL Anything. We demonstrate that our approach is theoretically sound, since it allows a single meta-model, based on RDF, to represent data from (a) any file format expressible in BNF syntax, as well as (b) any relational database. We compare our method to state-of-the-art approaches in terms of usability (cognitive complexity of the mappings) and general performance. Finally, we discuss the benefits and challenges of this novel approach by engaging with the reference user community.},
	number = {1},
	urldate = {2023-10-11},
	journal = {ACM Transactions on Internet Technology},
	author = {Asprino, Luigi and Daga, Enrico and Gangemi, Aldo and Mulholland, Paul},
	year = {2023},
	keywords = {RDF, SPARQL, meta-model, re-engineering, OntoRelA, RelRel},
	pages = {6:1--6:31},
	file = {Asprino et al. - 2023 - Knowledge Graph Construction with a Façade A Unif.pdf:/Users/samueldussault/Zotero/storage/DM87RV39/Asprino et al. - 2023 - Knowledge Graph Construction with a Façade A Unif.pdf:application/pdf},
}

@article{sicilia_map-_2017,
	title = {Map-{On}: {A} web-based editor for visual ontology mapping},
	volume = {8},
